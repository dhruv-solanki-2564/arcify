<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; all in-app styling lives in Compose (ArcifyTheme). -->
    <style name="Theme.Arcify" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- For the home-screen proxy, which only forwards and never draws. -->
    <style name="Theme.Arcify.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
